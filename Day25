"""
Day 25 - Arrays

Problem:
238. Product of Array Except Self

Pattern:
Prefix Product + Suffix Product
"""

class Solution:
    def productExceptSelf(self, nums):
        
        zeros = 0
        index = -1
        prod = 1
        
        res = [0] * len(nums)

        for i in range(len(nums)):
            
            if nums[i] == 0:
                zeros += 1
                index = i
            
            else:
                prod *= nums[i]

        if zeros == 1:
            res[index] = prod

        elif zeros == 0:
            
            for i in range(len(nums)):
                res[i] = prod // nums[i]

        return res
